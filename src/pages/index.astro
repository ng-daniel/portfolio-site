---

<html lang="en" data-theme="0">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/almost-white.png" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Daniel Ng is a game developer and software engineer building systems in Unity, C#, Python, and C++."
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<title>Daniel Ng</title>
	</head>
	<body id="top">
		<main>
			<div>
				<button
					class="home-logo"
					type="button"
					aria-label="Cycle color theme"
					data-theme-toggle
				>
					<span class="home-logo-mark" style={`--logo-mask: url('${logo.src}')`}></span>
				</button>
			</div>
			<br>
			<header>

				<p>
					Hi, I'm Daniel Ng.
				</p>
				<p>
					I'm a game developer and software engineer based in NYC pursuing a 
					Bachelors in CS at Purdue University.
				</p>
				<p>
					With 3+ years of game development, 2+ years with backend systems, and 10 completed
					game jams both solo and with teams, I bring solid fundamentals and creative
					engineering solutions to any team. 
				</p>
			</header>

			<section class="experience-section" aria-labelledby="experience">
				<h2 id="experience">experience</h2>
				<div class="experience-list">
					{experience.map((item) => (
						<article class:list={["experience-item", { current: item.current }]}>
							<div class="timeline-marker" aria-hidden="true"></div>
							<div class="experience-copy">
								<p class="meta">{item.period}</p>
								<p class="entry-title">{item.role} <a href={item.orgLink} target="_blank" rel="noreferrer">@ {item.org}</a></p>
								<ul class="dash-list">
									{item.bullets.map((bullet) => (
										<li>{bullet}</li>
									))}
								</ul>
							</div>
						</article>
					))}
				</div>
			</section>

			{portfolioSections.map((portfolioSection) => (
				<section aria-labelledby={portfolioSection.id}>
					<h2 id={portfolioSection.id}>{portfolioSection.id}</h2>
					{portfolioSection.items.map((project) => (
						<article class="project-item">
							<div class="project-head">
								<p class="entry-title">{project.name} <em>- {project.description}</em></p>
								{project.links.length > 0 && (
									<div class="project-links">
										{project.links.map((link) => (
											<a href={link.href} target="_blank" rel="noreferrer">{link.label}</a>
										))}
									</div>
								)}
							</div>
							{/* <p class="meta">{project.period}</p> */}
							<ul class="dash-list">
								{project.bullets.map((bullet) => (
									<li>{bullet}</li>
								))}
							</ul>
						</article>
					))}
				</section>
			))}

			<section aria-labelledby="skills">
				<h2 id="skills">skills</h2>
				<dl class="skills-list">
					{skills.map((skillGroup) => (
						<div class="skills-item">
							<dt>{skillGroup.category}</dt>
							<dd>{skillGroup.items.join(' · ')}</dd>
						</div>
					))}
				</dl>
			</section>

			<section aria-labelledby="contact">
				<h2 id="contact">contact</h2>
				<ul>
					{contacts.map((contact) => (
						<li>
							<span>{contact.label}</span>
							<a href={contact.href} target="_blank" rel="noreferrer">{contact.value}</a>
						</li>
					))}
				</ul>
			</section>
		</main>
		<script is:inline>
			const root = document.documentElement;
			const toggle = document.querySelector('[data-theme-toggle]');
			const themeCount = Number.parseInt(getComputedStyle(root).getPropertyValue('--theme-count'), 10) || 1;

			const setTheme = (index) => {
				root.dataset.theme = String(((index % themeCount) + themeCount) % themeCount);
			};

			setTheme(Number.parseInt(root.dataset.theme || '0', 10) || 0);

			toggle?.addEventListener('click', () => {
				const currentTheme = Number.parseInt(root.dataset.theme || '0', 10) || 0;
				setTheme(currentTheme + 1);
			});
		</script>
	</body>
</html>
