const projects = [
	{
		name: 'Falling Engine',
		description: 'Data-Oriented Game Engine',
		links: [
			{
				label: 'Github',
				href: 'https://github.com/ng-daniel/falling-engine',
			},
		],
		period: '2026',
		summary: 'C++/OpenGL ECS engine sustaining 60+ FPS with 36,000+ entities.',
	},
	{
		name: 'NYC Service Watch',
		description: 'Data Engineering & Analytics Pipeline',
		links: [
