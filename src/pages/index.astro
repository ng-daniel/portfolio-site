---
import Base from '../layouts/Base.astro';
import WorkGrid from '../components/WorkGrid.astro';
import ContactLinks from '../components/ContactLinks.astro';
import { getWork } from '../data/work';
import { home } from '../data/order';

const featured = await getWork(home);
---

<Base>
	<section>
		<p>
			Welcome to my site! I'm a game dev and software engineer studying CS at Purdue University
			with an interest in graphics, low-level game systems, and backend software.
		</p>
		<ContactLinks />
	</section>

	<section>
		<WorkGrid items={featured} />
		<p class="more"><a href="/work">all work →</a></p>
	</section>
</Base>
