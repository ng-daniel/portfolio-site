---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkGrid from '../components/WorkGrid.astro';
import ContactLinks from '../components/ContactLinks.astro';

const featured = (await getCollection('work', ({ data }) => data.featured))
	.sort((a, b) => a.data.order - b.data.order);
---

<Base>
	<section>
		<p>
			Welcome to my site! I'm a game dev and software engineer studying CS at Purdue University
			with an interest in graphics, systems, and software. My favorite fruits are apples!
		</p>
		<ContactLinks />
	</section>

	<section>
		<WorkGrid items={featured} />
		<p class="more"><a href="/work">all work →</a></p>
	</section>
</Base>
