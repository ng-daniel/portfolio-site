	{ label: 'GitHub', href: 'https://github.com/ng-daniel' },
	{ label: 'LinkedIn', href: 'https://www.linkedin.com/in/ngdaniel17/' },
	{ label: 'itch.io', href: 'https://fallingdani.itch.io/' },
