---

<html lang="en" data-theme="0">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/almost-white.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Daniel Ng is a game developer and software engineer building systems in Unity, C#, Python, and C++."
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<title>Daniel Ng</title>
		<script is:inline>
			try {
				const savedTheme = localStorage.getItem('portfolio-theme');
				if (savedTheme !== null) document.documentElement.dataset.theme = savedTheme;
			} catch {
				// The default theme remains available when browser storage is disabled.
			}
		</script>
	</head>
	<body id="top">
		<main>
			<div>
				<button
					class="home-logo"
					type="button"
					aria-label="Cycle color theme"
					data-theme-toggle
				>
					<span class="home-logo-mark" style={`--logo-mask: url('${logo.src}')`}></span>
				</button>
			</div>
			<br>
			<header>

				<p>
					Hi, I'm Daniel Ng, a game developer and software engineer studying CS (Graphics) at Purdue.
				</p>
				<nav class="intro-links" aria-label="Contact and profile links">
					{contacts.map((contact) => (
						<a
							href={contact.href}
							target={contact.href.startsWith('mailto:') ? undefined : '_blank'}
							rel={contact.href.startsWith('mailto:') ? undefined : 'noreferrer'}
						>{contact.label}</a>
					))}
				</nav>
			</header>

			<section class="experience-section" aria-labelledby="experience">
				<h2 id="experience">experience</h2>
				<div class="experience-list">
					{experience.map((item) => (
						<article class:list={["experience-item", { current: item.current }]}>
							<div class="timeline-marker" aria-hidden="true"></div>
							<div class="experience-copy">
								<p class="meta">{item.period}</p>
								<p class="entry-title">{item.role} <a href={item.orgLink} target="_blank" rel="noreferrer">@ {item.org}</a></p>
								<p class="summary">{item.summary}</p>
							</div>
						</article>
					))}
				</div>
			</section>

			{portfolioSections.map((portfolioSection) => (
				<section aria-labelledby={portfolioSection.id}>
					<h2 id={portfolioSection.id}>{portfolioSection.id}</h2>
					{portfolioSection.items.map((project) => (
						<article class="project-item">
							<div class="project-head">
								<p class="entry-title">{project.name} <em>- {project.description}</em></p>
								{project.links.length > 0 && (
									<div class="project-links">
										{project.links.map((link) => (
											<a href={link.href} target="_blank" rel="noreferrer">{link.label}</a>
										))}
									</div>
								)}
							</div>
							{/* <p class="meta">{project.period}</p> */}
							<p class="summary">{project.summary}</p>
						</article>
					))}
				</section>
			))}
		</main>
		<script is:inline>
			const root = document.documentElement;
			const toggle = document.querySelector('[data-theme-toggle]');
			const themeCount = Number.parseInt(getComputedStyle(root).getPropertyValue('--theme-count'), 10) || 1;

			const setTheme = (index) => {
				const theme = String(((index % themeCount) + themeCount) % themeCount);
				root.dataset.theme = theme;

				try {
					localStorage.setItem('portfolio-theme', theme);
				} catch {
					// Theme cycling still works when browser storage is disabled.
				}
			};

			setTheme(Number.parseInt(root.dataset.theme || '0', 10) || 0);

			const cycleTheme = () => {
				const currentTheme = Number.parseInt(root.dataset.theme || '0', 10) || 0;
				setTheme(currentTheme + 1);
			};

			if (toggle && 'PointerEvent' in window) {
				// Pointer events fire without the delayed synthetic click some mobile
				// browsers produce, while pointercancel prevents accidental changes
				// when a touch turns into a scroll.
				toggle.addEventListener('pointerup', (event) => {
					if (event.isPrimary && event.button === 0) cycleTheme();
				});

				// Keyboard and assistive-technology activation still arrives as a click.
				toggle.addEventListener('click', (event) => {
					if (event.detail === 0) cycleTheme();
				});
			} else {
				toggle?.addEventListener('click', cycleTheme);
			}
		</script>
	</body>
</html>
