---
import logo from "../assets/fallingdani-logo-black.png";
import "../styles/index.css";

const experience = [
	{
		role: 'Software Engineer',
		org: 'Purdue Envision Center',
		orgLink: 'https://www.rcac.purdue.edu/envision',
		period: 'Mar 2026 - Present',
		current: true,
		bullets: [
			'Developing multiplayer XR applications for interactive data visualization in Unity and educational fluid dynamics tools. Improved runtime stability by implementing a fixed-buffer memory system and reverse-engineering legacy AWS S3 asset-loading pipelines.'
		]
	},
	{
		role: 'Independent Game Developer',
		org: 'Fallingdani Games',
		orgLink: 'https://fallingdani.itch.io/',
		period: 'Jul 2023 - Present',
		current: true,
		bullets: [
			'Designed, developed, and published several games, handling programming, art, audio, and release from concept to post-launch updates. Accumulated 1,700+ views, 700+ plays, and game jam awards such as top 3% enjoyment ranking in GMTK Game Jam 2025.'
		]
	},
	{
		role: 'Lead Software Researcher',
		org: 'TDM x Caterpillar',
		orgLink: 'https://datamine.purdue.edu/',
		period: 'Aug 2025 - May 2026',
		current: false,
		bullets: [
			'Led the backend team for an AI-powered industrial data analysis platform built with FastAPI. Designed an MCP server and LLM orchestration pipeline to automate data analysis and visualization from natural-language queries.'
		]
	},
];

const projects = [
	{
		name: 'Echoes of Isovios',
		description: '2D Action Platformer Roguelike',
		links: [
			{
				label: 'Play on Steam',
				href: 'https://store.steampowered.com/app/4363270/Echoes_of_Isovios_A_Legacy_Undone/',
			},
			{
				label: 'Github',
				href: 'https://github.com/PurdueSIGGD/SIGGD-Game-2024',
			},
		],
		period: 'Aug 2024 - Jan 2026',
		bullets: [
			'2D action platformer roguelike built with Purdue ACM SIGGD. Developed 17 enemy types and four boss encounters in Unity while improving enemy architecture as part of a 20+ member team.'
		],
	},
];

const contacts = [
	{ label: 'email', value: '71danielng@gmail.com', href: 'mailto:71danielng@gmail.com' },
	{ label: 'github', value: 'github.com/ng-daniel', href: 'https://github.com/ng-daniel' },
	{ label: 'linkedin', value: 'linkedin.com/in/ngdaniel17', href: 'https://www.linkedin.com/in/ngdaniel17/' },
	{ label: 'itch.io', value: 'fallingdani.itch.io', href: 'https://fallingdani.itch.io/' }
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Daniel Ng is a game developer and software engineer building systems in Unity, C#, Python, and C++."
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<title>Daniel Ng</title>
	</head>
	<body id="top">
		<main>
			<div>
				<a class="home-logo" href="#top" aria-label="Back to top">
					<img src={logo.src} alt="Daniel Ng logo" />
				</a>
			</div>
			<br>
			<header>

				<p>
					Hi, I'm Daniel Ng! I'm a game developer and software engineer pursuing a 
					Bachelors in CS at Purdue University.
					I have 3+ years of experience making interactive experiences in Unity and C#, 
					and 2+ years of experience building backend systems in Python and C++.
				</p>
				<p>
					With 10 total game jam completions, most under 72 hours and some with top placements, 
					I’m on a first-name basis with the game development lifecycle, from starting a fresh 
					design document to architecting robust game systems and iterating on player feedback.
				</p>
				<p>
					I'm currently a Software Engineer for realtime simulations at the Envision Center, where I build 
					interactive applications for research and education.
				</p>
			</header>

			<section class="experience-section" aria-labelledby="experience">
				<h2 id="experience">experience</h2>
				<div class="experience-list">
					{experience.map((item) => (
						<article class:list={["experience-item", { current: item.current }]}>
							<div class="timeline-marker" aria-hidden="true"></div>
							<div class="experience-copy">
								<p class="meta">{item.period}</p>
								<p class="entry-title">{item.role} @ <a href={item.orgLink} target="_blank" rel="noreferrer">{item.org}</a></p>
								<ul class="dash-list">
									{item.bullets.map((bullet) => (
										<li>{bullet}</li>
									))}
								</ul>
							</div>
						</article>
					))}
				</div>
			</section>

			<section aria-labelledby="projects">
				<h2 id="projects">projects</h2>
				{projects.map((project) => (
					<article class="project-item">
						<div class="project-head">
							<p class="entry-title">{project.name} <em>- {project.description}</em></p>
							<div class="project-links">
								{project.links.map((link) => (
									<a href={link.href} target="_blank" rel="noreferrer">{link.label}</a>
								))}
							</div>
						</div>
						{/* <p class="meta">{project.period}</p> */}
						<ul class="dash-list">
							{project.bullets.map((bullet) => (
								<li>{bullet}</li>
							))}
						</ul>
					</article>

				))}
			</section>

			<section aria-labelledby="contact">
				<h2 id="contact">contact</h2>
				<ul>
					{contacts.map((contact) => (
						<li>
							<span>{contact.label}</span>
							<a href={contact.href} target="_blank" rel="noreferrer">{contact.value}</a>
						</li>
					))}
				</ul>
			</section>
		</main>
	</body>
</html>