---
import Base from '../../layouts/Base.astro';
import WorkGrid from '../../components/WorkGrid.astro';
import { getWork } from '../../data/work';
import { major, minor } from '../../data/order';

const majorItems = await getWork(major);
const minorItems = await getWork(minor, { appendUnlisted: true });
---

<Base title="Work">
	<section aria-labelledby="major">
		<h2 id="major">major projects</h2>
		<WorkGrid items={majorItems} variant="major" />
	</section>

	<section aria-labelledby="minor">
		<h2 id="minor">jams &amp; smaller projects</h2>
		<WorkGrid items={minorItems} dense />
	</section>
</Base>
