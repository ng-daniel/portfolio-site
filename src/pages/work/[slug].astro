---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Reel from '../../components/Reel.astro';

export async function getStaticPaths() {
	const work = await getCollection('work');
	return work.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

interface Props {
	item: CollectionEntry<'work'>;
}

const { item } = Astro.props;
const { Content } = await render(item);
---

<Base title={item.data.title} description={item.data.summary}>
	<p class="back"><a href="/work" data-back>← all work</a></p>
	<article>
		<Reel src={item.data.reel} poster={item.data.poster} alt={item.data.title} />
		<h1>{item.data.title} <em>- {item.data.description}</em></h1>
		<p class="meta">{item.data.period}</p>
		<p class="summary">{item.data.summary}</p>
		{item.data.links.length > 0 && (
			<nav class="links" aria-label={`${item.data.title} links`}>
				{item.data.links.map((link) => (
					<a href={link.href} target="_blank" rel="noreferrer">{link.label}</a>
				))}
			</nav>
		)}
		<div class="body">
			<Content />
		</div>
		{item.data.gallery.length > 0 && (
			<ul class="grid">
				{item.data.gallery.map((media) => (
					<li><Reel src={media} poster={item.data.poster} alt={item.data.title} /></li>
				))}
			</ul>
		)}
	</article>

	<script is:inline>
		// Coming from /work, going back through history restores its scroll
		// position and filter. Otherwise the link just opens /work.
		document.querySelector('[data-back]').addEventListener('click', (event) => {
			if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
			if (!document.referrer) return;

			const referrer = new URL(document.referrer);
			if (referrer.origin === location.origin && referrer.pathname.replace(/\/$/, '') === '/work') {
				event.preventDefault();
				history.back();
			}
		});
	</script>
</Base>
