---
import Base from '../layouts/Base.astro';

const experience = [
	{
		role: 'Simulation Programmer',
		org: 'Envision Center',
		orgLink: 'https://www.rcac.purdue.edu/envision',
		period: 'Mar 2026 - Present',
		current: true,
		summary: 'Building CollabXR, a mixed-reality classroom, and interactive fluid-dynamics visualizations.',
	},
	{
		role: 'Independent Game Developer',
		org: 'Fallingdani Games',
		orgLink: 'https://fallingdani.itch.io/',
		period: 'Jul 2023 - Present',
		current: true,
		summary: 'Shipped 11 Unity/C# games under 48-72 hour game jam deadlines.',
	},
	{
		role: 'Undergraduate Research Software Engineer',
		org: 'TDM x Caterpillar Inc.',
		orgLink: 'https://datamine.purdue.edu/caterpillar/',
		period: 'Aug 2025 - May 2026',
		current: false,
		summary: 'Led a 5-person team building an LLM analysis API with FastAPI, AWS Bedrock, and MCP.',
	},
];
---

<Base title="About">
	<section>
		<p>Game developer and software engineer based in NY, studying CS with a Graphics concentration at Purdue University.</p>
		<nav class="links" aria-label="Resume">
			<a href="/daniel_ng_resume.pdf" target="_blank" rel="noreferrer">Resume</a>
		</nav>
	</section>

	<section aria-labelledby="experience">
		<h2 id="experience">experience</h2>
		<div class="experience-list">
			{experience.map((item) => (
				<article class:list={["experience-item", { current: item.current }]}>
					<div class="timeline-marker" aria-hidden="true"></div>
					<div>
						<p class="meta">{item.period}</p>
						<p class="entry-title">{item.role} <a href={item.orgLink} target="_blank" rel="noreferrer">@ {item.org}</a></p>
						<p class="summary">{item.summary}</p>
					</div>
				</article>
			))}
		</div>
	</section>
</Base>
