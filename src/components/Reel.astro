---
interface Props {
	src: string;
	poster?: string;
	alt?: string;
}

const { src, poster, alt = '' } = Astro.props;
const isVideo = /\.(mp4|webm)$/i.test(src);
---

{isVideo ? (
	<video
		class="reel"
		src={src}
		poster={poster}
		muted
		loop
		playsinline
		preload="none"
		aria-hidden="true"
		data-reel
	></video>
) : (
	<img class="reel" src={src} alt={alt} loading="lazy" decoding="async" />
)}
