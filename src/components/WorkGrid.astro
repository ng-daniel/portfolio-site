---
import type { CollectionEntry } from 'astro:content';
import Reel from './Reel.astro';

interface Props {
	items: CollectionEntry<'work'>[];
}

const { items } = Astro.props;

// scripts/dither-poster.sh writes /media/dither/<name>.png for each /media/<name>.<ext> poster.
const ditherPath = (poster: string) => poster.replace(/^(.*)\/([^/]+)\.\w+$/, '$1/dither/$2.png');
---

<ul class="grid">
	{items.map((item) => (
		<li data-kind={item.data.kind}>
			<a class="tile" href={`/work/${item.id}`}>
				<span class="frame">
					<Reel src={item.data.reel} poster={item.data.poster} alt={item.data.title} preload="none" />
					<span class="dither" style={`--dither: url('${ditherPath(item.data.poster)}')`} aria-hidden="true"></span>
				</span>
				<span class="tile-caption">
					<span>{item.data.title}</span>
					<span class="meta">{item.data.kind}</span>
				</span>
				<span class="tile-description meta">{item.data.description}</span>
			</a>
		</li>
	))}
</ul>
